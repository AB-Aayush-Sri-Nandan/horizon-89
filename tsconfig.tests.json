{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "es2023",
      "dom"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "playwright.config.ts",
    "shared/**/*.ts",
    "server/**/*.ts",
    "scripts/**/*.ts"
  ]
}
