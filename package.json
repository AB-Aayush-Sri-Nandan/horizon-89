{
  "name": "lunar-ops",
  "private": true,
  "version": "0.4.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build && npm run build:server",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:server": "tsc -p tsconfig.server.json",
    "dev:api": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env --watch dist-server/server/index.js",
    "start": "NODE_ENV=production NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env dist-server/server/index.js",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "playwright test",
    "dev:web": "vite",
    "science:ingest": "node --experimental-strip-types scripts/science/ingest-dem.ts",
    "science:fetch": "NODE_USE_ENV_PROXY=1 node scripts/science/fetch-dem.mjs",
    "science:verify-horizons": "NODE_USE_ENV_PROXY=1 node --experimental-strip-types scripts/science/verify-horizons.ts",
    "science:inspect": "node --experimental-strip-types scripts/science/ingest-dem.ts --inspect",
    "check:secrets": "node scripts/check-secrets.mjs",
    "science:import-moon": "node --experimental-strip-types scripts/science/import-moon.ts",
    "test:ai:live": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env scripts/test-ai-live.mjs",
    "imagery:prepare": "NODE_USE_ENV_PROXY=1 node scripts/science/prepare-planet-textures.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=24"
  }
}
